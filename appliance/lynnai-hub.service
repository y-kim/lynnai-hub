# systemd unit for the LYNNAI hub. Install (code at /opt/lynnai-hub):
#   sudo cp lynnai-hub.service /etc/systemd/system/ && sudo systemctl enable --now lynnai-hub
# Needs hostapd, dnsmasq, iw installed, with their own system services disabled
# (this unit starts them itself with the hub's generated configs).
[Unit]
Description=LYNNAI hub (Wi-Fi AP + setup portal)
After=network-online.target NetworkManager.service
Wants=network-online.target
# 실패가 5분에 3번 넘으면 재시작 중단 — 무선칩을 계속 건드려 wlan0(SSH)을 끊는 루프 방지
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/python3 -u /opt/lynnai-hub/appliance/main.py --state /var/lib/lynnai/device.json
ExecStopPost=/usr/bin/python3 /opt/lynnai-hub/appliance/apctl.py down --state /var/lib/lynnai/device.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
