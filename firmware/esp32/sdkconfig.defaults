#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# end of Partition Table

#
# Zigbee
#
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
# end of Zigbee

#
# LYNNAI hub: ESP32-C6-DevKitC-1 (8MB flash)
#
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 설정 포털(esp_http_server): 폰 브라우저 요청 헤더가 기본 512B 를 넘는 경우가 흔하다
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# DNS + 포털(최대 5연결) + 443/853 끊기 리스너에 소켓이 더 필요
CONFIG_LWIP_MAX_SOCKETS=16
# 클라우드 쪽 연결(TLS 1.2/1.3)
CONFIG_WOLFSSL_ALLOW_TLS13=y
CONFIG_WOLFSSL_ALLOW_TLS12=y

# 스택 보호(네트워크 파서가 많아서) — 깨진 스택을 바로 잡아낸다
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# Cloudflare/Google 등 공개 HTTPS 인증서 체인의 P-384 루트(예: GTS Root R4) 검증용
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y

# gas.yangsu.kim 체인(WE1·GTS Root R4)이 SHA-384 서명이라 필요
CONFIG_MBEDTLS_SHA512_C=y
