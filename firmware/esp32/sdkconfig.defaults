#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# end of Partition Table

#
# Zigbee
#
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
# end of Zigbee

#
# LYNNAI hub: ESP32-C6-DevKitC-1 (8MB flash)
#
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 설정 포털(esp_http_server): 폰 브라우저 요청 헤더가 기본 512B 를 넘는 경우가 흔하다
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# DNS + 포털(최대 5연결) + 443/853 끊기 리스너에 소켓이 더 필요
CONFIG_LWIP_MAX_SOCKETS=16
# 클라우드 쪽 연결(TLS 1.2/1.3)
CONFIG_WOLFSSL_ALLOW_TLS13=y
CONFIG_WOLFSSL_ALLOW_TLS12=y

# 스택 보호(네트워크 파서가 많아서) — 깨진 스택을 바로 잡아낸다
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# Cloudflare/Google 등 공개 HTTPS 인증서 체인의 P-384 루트(예: GTS Root R4) 검증용
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y

# gas.yangsu.kim 체인(WE1·GTS Root R4)이 SHA-384 서명이라 필요
CONFIG_MBEDTLS_SHA512_C=y

# HTTPS 클라이언트(가스 요금 조회)의 TLS 버퍼를 필요할 때만 잡는다 — 고정 16K+4K 버퍼 대신. 허브의 남은 힙이 40~50KB 라
# 고정 버퍼로는 조회를 시작할 여유(60KB)가 나오지 않았다.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# RAM 줄이기. 줄이기 전: 남은 힙이 평소 50KB, 프록시 연결을 맺는 순간 1~8KB. 줄인 뒤(실측): 평소 84KB, 그 순간 36KB.
# Wi-Fi 코드를 RAM(IRAM)에 올려 두지 않는다: 처리량이 조금 줄지만 허브가 주고받는 양은 아주 적다.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Wi-Fi 수신 버퍼: 늘 잡아 두는 것 10 → 6(개당 1.6KB), 몰릴 때 힙에서 더 잡는 한도 32 → 16(한꺼번에 50KB 를 쓰지 못하게)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
# 태스크별 스택 최소 여유를 /api/v1/bootlog?part=tasks 로 본다
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
